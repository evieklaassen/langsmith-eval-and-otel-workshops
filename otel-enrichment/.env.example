# Copy to .env (cp .env.example .env). .env is git-ignored.
# You do NOT put your LangSmith key here: notebook 1 asks for it (hidden input) and writes it to .env for you.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=otel-metadata-workshop
WORKSHOP_SFX=local
WORKSHOP_PROJECT_BASE=otel-metadata-workshop

# --- AWS / Amazon Bedrock -------------------------------------------------
# Use ONE of these: access keys (below), or leave them commented and set AWS_PROFILE
# (or run `aws sso login`) in the shell that starts Jupyter. Add AWS_SESSION_TOKEN for temporary credentials.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1
BEDROCK_REGION=us-east-1

# --- Which models? -------------------------------------------------------
# LLM_PROVIDER=bedrock (default): Claude on Amazon Bedrock, needs the AWS block above.
# LLM_PROVIDER=ollama: open-source models on a local Ollama, no cloud account needed.
#   Install Ollama, then:  ollama pull llama3.2:3b
# LLM_PROVIDER=openai_compatible: any OpenAI-compatible server (LM Studio, vLLM, llama.cpp, a hosted
#   open-source endpoint). Also set LLM_BASE_URL (and LLM_API_KEY if it needs one).
# Models must support tool calling. For ollama/openai_compatible the AWS block is ignored.
LLM_PROVIDER=bedrock
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# Model for the agent and the LLM judge.
# Bedrock (US geo inference profile):
BEDROCK_MODEL_HAIKU=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Ollama / open-source: set LLM_MODEL (it overrides BEDROCK_MODEL_HAIKU), e.g.
# LLM_MODEL=llama3.2:3b
